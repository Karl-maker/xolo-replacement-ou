{
  "name": "@ou-manager/db",
  "version": "0.1.0",
  "description": "PostgreSQL persistence for the OÜ business manager (Prisma schema, migrations, repositories)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma/migrations"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/generate-client.mjs",
    "build": "pnpm --filter @ou-manager/core build && pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @ou-manager/core build && pnpm generate && tsc -p tsconfig.json",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:test": "prisma migrate deploy --config prisma.test.config.ts",
    "test:integration": "pnpm generate && vitest run"
  },
  "dependencies": {
    "@ou-manager/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
